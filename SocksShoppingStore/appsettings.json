{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "localhost;127.0.0.1;testsocksshop-agdng4gkcyeuhpgs.westeurope-01.azurewebsites.net"
  ,
  "FreeTier": {
    "Enabled": true,
    "BlockAllTraffic": false,
    "BlockOnAzure": false,
    "AllowPaths": [ "/healthz", "/_status", "/favicon.ico" ]
  },
  "RateLimiting": {
    "GlobalPerMinute": 40,
    "ApiPerMinute": 20
  },
  "Concurrency": {
    "MaxConcurrentRequests": 10
  },
  "Status": {
    "AllowIPs": [ "127.0.0.1", "::1" ],
    "LatencyWindowSize": 200
  },
  "Legal": {
    "ControllerName": "SocksShoppingStore",
    "ContactEmail": "support@socksshop.local"
  },
  "Repository": {
    "Provider": "InMemory", 
    "Json": {
      "Path": "App_Data/products.json"
    }
  },
  "Stripe": {
    "PublishableKey": "",
    "SecretKey": "",
    "WebhookSecret": "",
    "UseTestModeBanner": true,
    "SuccessReturnPath": "/Checkout/ReturnSuccess",
    "CancelReturnPath": "/Checkout/PaymentFailed"
  },
  "Tax": {
    "Enabled": true,
    "Mode": "Vat",
    "PricesIncludeTax": true,
    "DefaultRatePercent": 20.0,
    "Label": "VAT"
  },
  "Shipping": {
    "Default": "standard",
    "Methods": [
      { "Code": "standard", "Name": "Standard (3-5 days)", "Price": 3.50, "Taxable": true },
      { "Code": "express",  "Name": "Express (1-2 days)",  "Price": 7.00, "Taxable": true }
    ]
  },
  "Promotions": {
    "Codes": [
      { "Code": "HELLO10", "Type": "Percent", "Value": 10, "MinSubtotal": 10.00, "ExpiresUtc": "2099-12-31T00:00:00Z", "Active": true }
    ]
  },
  "Features": {
    "EnableTaxes": true,
    "EnableShipping": true,
    "EnablePromoCodes": true,
    "EnablePdfInvoices": true,
    "OnlyInDevelopment": true
  }
}
