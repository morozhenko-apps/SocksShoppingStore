@model SocksShoppingStore.Models.CheckoutViewModel
@{
    ViewData["Title"] = T["Checkout_Title"];
}

<h1>@ViewData["Title"]</h1>

<form asp-action="Index" method="post" class="row g-3"> 
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input type="text" name="Website" value="" class="d-none" autocomplete="off" tabindex="-1" aria-hidden="true" />

    <div class="col-md-6">
        <label for="CustomerName" class="form-label">@T["FullName"]</label>
        <input asp-for="CustomerName" class="form-control" />
        <span asp-validation-for="CustomerName" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label for="Email" class="form-label">@T["Email"]</label>
        <input asp-for="Email" class="form-control" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>
    <div class="col-12">
        <label for="AddressLine1" class="form-label">@T["AddressLine1"]</label>
        <input asp-for="AddressLine1" class="form-control" />
        <span asp-validation-for="AddressLine1" class="text-danger"></span>
    </div>
    <div class="col-12">
        <label for="AddressLine2" class="form-label">@T["AddressLine2"]</label>
        <input asp-for="AddressLine2" class="form-control" />
    </div>
    <div class="col-md-4">
        <label for="City" class="form-label">@T["City"]</label>
        <input asp-for="City" class="form-control" />
        <span asp-validation-for="City" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label for="PostalCode" class="form-label">@T["PostalCode"]</label>
        <input asp-for="PostalCode" class="form-control" />
        <span asp-validation-for="PostalCode" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label for="Country" class="form-label">@T["Country"]</label>
        <input asp-for="Country" class="form-control" />
        <span asp-validation-for="Country" class="text-danger"></span>
    </div>

    @{
        var shippingMethods = ViewBag.ShippingMethods as System.Collections.Generic.List<SocksShoppingStore.Config.ShippingMethod>;
    }
    @if (shippingMethods != null)
    {
        <div class="col-md-6">
            <label for="ShippingMethod" class="form-label">@T["ShippingMethod"]</label>
            <select asp-for="ShippingMethod" class="form-select">
                @foreach (var m in shippingMethods)
                {
                    <option value="@m.Code">@m.Name (@SocksShoppingStore.Helpers.Currency.Eur(m.Price))</option>
                }
            </select>
        </div>
        <div class="col-md-6">
            <label for="PromoCode" class="form-label">@T["PromoCode"]</label>
            <input asp-for="PromoCode" class="form-control" />
        </div>
    }

    <div class="col-12 d-grid d-sm-flex gap-2">
        <a asp-controller="Cart" asp-action="Index" class="btn btn-outline-secondary">@T["BackToCart"]</a>
        <button type="submit" class="btn btn-primary">@T["ReviewOrder"]</button>
    </div>
    <div class="col-12">
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="text-danger">@T["CorrectErrorsAbove"]</div>
        }
    </div>
</form>

@section Scripts{
    <partial name="_ValidationScriptsPartial" />
}
