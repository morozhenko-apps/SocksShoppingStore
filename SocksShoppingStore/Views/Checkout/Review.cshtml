@model SocksShoppingStore.Models.Order
@{
    ViewData["Title"] = T["ReviewOrder"];
}

<h1>@ViewData["Title"]</h1>

<div class="card mb-3">
  <div class="card-header">@T["ShippingDetails"]</div>
  <div class="card-body">
    <p class="mb-1"><strong>@T["Name"]:</strong> @Model.CustomerName</p>
    <p class="mb-1"><strong>@T["Email"]:</strong> @Model.Email</p>
    <p class="mb-0"><strong>@T["Address"]:</strong> @Model.AddressLine1 @Model.AddressLine2<br/>@Model.City, @Model.PostalCode, @Model.Country</p>
  </div>
</div>

<table class="table align-middle">
  <thead>
    <tr><th>@T["Item"]</th><th class="text-center">@T["Quantity"]</th><th class="text-end">@T["Price"]</th></tr>
  </thead>
  <tbody>
  @foreach(var it in Model.Items)
  {
    <tr>
      <td>@it.Name</td>
      <td class="text-center">@it.Quantity</td>
      <td class="text-end">@SocksShoppingStore.Helpers.Currency.Eur(it.Subtotal)</td>
    </tr>
  }
  </tbody>
  <tfoot>
    @if (Model?.Totals?.Discount > 0)
    {
      <tr>
        <td colspan="2" class="text-end">@T["Discount"]</td>
        <td class="text-end">-@SocksShoppingStore.Helpers.Currency.Eur(Model!.Totals!.Discount)</td>
      </tr>
    }
    @if (Model?.Totals?.Shipping > 0)
    {
      <tr>
        <td colspan="2" class="text-end">@T["Shipping"]</td>
        <td class="text-end">@SocksShoppingStore.Helpers.Currency.Eur(Model!.Totals!.Shipping)</td>
      </tr>
    }
    <tr>
      <td colspan="2" class="text-end">
        @{
          var taxLabel = Model?.Totals?.TaxLabel ?? "VAT";
          var taxRate = Model?.Totals?.TaxRatePercent ?? 0m;
        }
        @taxLabel @if (taxRate > 0) { <text>(@taxRate.ToString("0.##")%)</text> }
      </td>
      <td class="text-end">@SocksShoppingStore.Helpers.Currency.Eur(Model?.Totals?.TaxAmount ?? 0)</td>
    </tr>
    <tr>
      <td colspan="2" class="text-end"><strong>@T["TotalInclVAT"]</strong></td>
      <td class="text-end"><strong>@SocksShoppingStore.Helpers.Currency.Eur(Model?.Totals?.TotalInclTax ?? Model.Total)</strong></td>
    </tr>
  </tfoot>
</table>

@if (TempData["Error"] is string err && !string.IsNullOrWhiteSpace(err))
{
  <div class="alert alert-danger" role="alert">@err</div>
}

<form asp-action="Confirm" method="post">
  @Html.AntiForgeryToken()
  <div class="d-grid d-sm-flex gap-2">
    <a asp-action="Index" class="btn btn-outline-secondary">@T["EditDetails"]</a>
    <button type="submit" class="btn btn-success">@T["PayNow"]</button>
  </div>
</form>
